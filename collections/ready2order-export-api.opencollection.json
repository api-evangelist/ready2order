              },
              {
                "name": "month",
                "value": "",
                "type": "query"
              },
              {
                "name": "day",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateFrom",
                "value": "",
                "type": "query",
                "description": "<br><br> _* Required when `dateTo` is provided._"
              },
              {
                "name": "dateTo",
                "value": "",
                "type": "query",
                "description": "<br><br> _* Required when `dateFrom` is provided._"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Export Cashbook"
        },
