        {
          "info": {
            "name": "Create products in bulk",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ready2order.com/v1/products/batch",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates multiple products in a single request. Returns a result for each item along with a count of how many succeeded and how many failed."
        },
