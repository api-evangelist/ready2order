{
  "opencollection": "1.0.0",
  "info": {
    "name": "ready2order Public Account Token Order API",
    "version": "R2-2026.30.2"
  },
  "items": [
    {
      "info": {
        "name": "Order",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ready2order.com/v1/orders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page you want to display"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page"
              },
              {
                "name": "groupBy",
                "value": "",
                "type": "query",
                "description": "allowed values: table_id or product_id or both"
              },
              {
                "name": "trainingsMode",
                "value": "",
                "type": "query",
                "description": "retrieve results for trainingsMode or liveMode"
              },
              {
                "name": "table_id",
                "value": "",
                "type": "query",
                "description": "table id"
              },
              {
                "name": "product_id",
                "value": "",
                "type": "query",
                "description": "product id"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List all Orders"
        },
        {
          "info": {
            "name": "Create a new Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ready2order.com/v1/orders",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create a new Order"
        },
        {
          "info": {
            "name": "Transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ready2order.com/v1/orders/transfer",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Transfers unbilled order items from one table to another.<br>Pass specific `order_ids` to transfer a subset, or omit the field to transfer all unbilled items on the source table."
        }
      ]
    }
  ],
  "bundled": true
